# Worktrees that Claude Code subagents create for isolated work.
.claude/worktrees/

# This repository commits no .aries.yaml: a contributor's names their own
# server (and may hold a test CA), so it stays untracked in their main
# checkout, where aries in a worktree finds it.
/.aries.yaml

# Editor and IDE settings are personal; keep them out of the repository.
.idea/
*.iml
.vscode/
.fleet/
.zed/
*.code-workspace
.DS_Store

# What CI's test command writes (-coverprofile), for a run of it by hand.
coverage.out
