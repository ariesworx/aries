# AppArmor profiles for ariesd, the Aries server (docs/server.md,
# "Confine ariesd with AppArmor"). Install this file as
# /etc/apparmor.d/ariesd, tunables/ariesd beside it as
# /etc/apparmor.d/tunables/ariesd and abstractions/ariesd-admin as
# /etc/apparmor.d/abstractions/ariesd-admin; then ariesd-stdio with SSH
# on, or ariesd-default with SSH off, as /etc/apparmor.d/ariesd-stdio or
# /etc/apparmor.d/ariesd-default. README.md says how they were tested.
#
# One binary does three jobs, and each gets the profile that fits it:
#
#   ariesd-stdio    the bridge, `ariesd stdio`, which sshd runs for
#                     every connection, in a file of its own,
#                     ariesd-stdio, which only a server with SSH on
#                     installs. Attached to the binary's path, so it is
#                     also what any run gets that asks for nothing else:
#                     `ariesd status`, which needs the same two things,
#                     runs under it as the aries user.
#   ariesd-default  what a server with SSH off puts on the same path in
#                     its place, in a file of its own, ariesd-default:
#                     the operator's rules, so that a command run
#                     without aa-exec is confined too.
#   ariesd-serve    the daemon, `ariesd serve`. The systemd unit asks
#                     for it with AppArmorProfile=ariesd-serve.
#   ariesd-admin    the operator's commands: control init, import-bd,
#                     export-bd and upgrade. The operator asks for it:
#                     sudo -u aries -H aa-exec -p ariesd-admin -- ariesd upgrade
#                     Its rules are abstractions/ariesd-admin's, which
#                     ariesd-default shares.
#
# AppArmor chooses a profile by the path of the program, never by its
# arguments, so the one path can carry only one profile by itself, and
# ariesd-stdio and ariesd-default are never loaded together. With SSH on
# the path carries the smallest, because sshd starts the bridge with no
# way to ask for another, outside the systemd unit and its sandbox. With
# SSH off nothing runs as sshd's forced command, and the path carries
# the operator's rules. The daemon
# and the operator's commands may reach Postgres; the daemon alone may
# write the keys file; the operator's profile alone may replace the
# binary and run sudo. No
# profile may change to another, and the bridge and the daemon run no
# program at all.
#
# The paths are tunables/ariesd's. Rules of your own go in
# /etc/apparmor.d/local/ariesd-serve and local/ariesd-admin (which
# ariesd-default reads too), and in
# local/ariesd-stdio for the bridge, which upgrades of these files leave
# alone. A deny rule here wins over anything those files allow.

abi <abi/4.0>,

include <tunables/global>
include <tunables/ariesd>

# The daemon. It reads the config file, listens on its socket and, with
# HTTPS on, on its HTTPS listener, talks to Postgres, by its unix socket
# on this machine or over TCP to another, and on a server of many
# projects with SSH on writes the keys file sshd reads, and reads the
# hand-maintained authorized_keys beside it.
# When it is configured to (docs/server.md, Observability) it also
# listens on a loopback TCP port for /metrics and health, posts metrics
# and traces to a collector over HTTP, keeps the key of the stand-ins
# its traces name people by, and tells systemd it is ready and alive.
profile ariesd-serve flags=(attach_disconnected) {
  include <abstractions/base>

  @{ariesd_bin}/ariesd mr,
  @{ariesd_config} r,

  # The account's home directory, from the account database.
  /etc/passwd r,

  # The socket: its directory is checked, a stale socket removed, a new
  # one bound and made 0600.
  @{ariesd_run}/ r,
  @{ariesd_run}/ariesd.sock rw,
  @{PROC}/sys/net/core/somaxconn r,

  # Postgres on this machine, by its unix socket: a file to AppArmor.
  # The guide's DSN names the socket's directory (host=/var/run/postgresql,
  # a link to /run/postgresql, and AppArmor names where a link leads).
  @{ariesd_pg_socket}/.s.PGSQL.* rw,

  # The database's client files: the password file a DSN names
  # (passfile=), and the certificate authority it trusts for TLS
  # (sslrootcert=), for a Postgres on another machine or a managed
  # service (docs/server.md, Managed services).
  @{ariesd_db_files}/ r,
  @{ariesd_db_files}/** r,

  # Postgres on another machine, over TCP, to any address: this profile
  # does not rely on rules that name an address or a port, which were
  # not tested. The unit can hold the daemon to this machine instead
  # (IPAddressDeny=any with IPAddressAllow=localhost, in a drop-in).
  #
  # The same two rules are all the telemetry needs on this machine: the
  # listener (telemetry: listen:, which ariesd itself holds to a
  # loopback address) and OTLP over HTTP to a collector at an address
  # (OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318).
  network inet stream,
  network inet6 stream,

  # A dsn, the listener's address or the collector's endpoint may give
  # a host by name, as a managed Postgres's DSN does. Go resolves names
  # itself, from these files and over DNS. A managed Postgres's TLS, and
  # metrics sent straight to a hosted backend, need the certificate
  # authorities that vouch for them (sslrootcert=system, or Go's own
  # roots). Both are allowed always (design decision 85): they only
  # read, or are implied by network inet stream.
  network inet dgram,
  network inet6 dgram,
  include <abstractions/ssl_certs>
  /etc/hosts r,
  /etc/nsswitch.conf r,
  /etc/resolv.conf r,
  @{run}/systemd/resolve/resolv.conf r,
  @{run}/systemd/resolve/stub-resolv.conf r,

  # The HTTPS listener (docs/server.md, The HTTPS listener) listens by
  # network inet stream, above, and binds a port below 1024 by the
  # capability the unit's drop-in gives it (AmbientCapabilities). With
  # its certificate in files it reads them, and again when they change;
  # with ACME it keeps the account's key and the certificates in a
  # directory of its own, which it makes if it is missing, through a
  # temporary file and a rename.
  capability net_bind_service,
  @{ariesd_tls}/ r,
  @{ariesd_tls}/** r,
  owner @{ariesd_acme}/ rw,
  owner @{ariesd_acme}/** rw,

  # Sign-in (docs/server.md, Sign-in): each provider's client secret,
  # the CA of its certificate and, offline, its key set, read at start
  # and the key set again when a token names a key it lacks. Reaching
  # a provider is network inet stream, DNS and abstractions/ssl_certs,
  # above.
  @{ariesd_login}/ r,
  @{ariesd_login}/** r,

  # The keys file: a temporary file beside it, written, synced and
  # renamed over it, and removed when SSH is off. authorized_keys is
  # only ever read.
  owner @{ariesd_keys_dir}/ r,
  owner @{ariesd_keys_dir}/@{ariesd_keys_name} rw,
  owner @{ariesd_keys_dir}/.@{ariesd_keys_name}.tmp-* rw,
  owner @{ariesd_authorized_keys} r,

  # The key that principals' stand-ins in traces are made with
  # (telemetry: principals: pseudonym, the default). The daemon makes
  # the file once, the first time it exports traces, and reads it at
  # each start; it writes no other file there, so the rule names the
  # one file and not its directory. Without it the daemon still runs:
  # its traces say nothing about who, and its log and its status say
  # that the key cannot be made.
  owner @{ariesd_principals_key} rw,

  # systemd's notify socket. With Type=notify in the unit the daemon
  # says when it is ready and when it stops, and with WatchdogSec that
  # it is alive: one datagram each, to a socket that is a file to
  # AppArmor. Without this rule a unit with Type=notify never counts as
  # started, and systemd kills it when TimeoutStartSec runs out.
  @{run}/systemd/notify w,

  # Signals among its own threads: Go preempts a long-running goroutine
  # with SIGURG. abstractions/base allows a profile to signal itself
  # (peer=@{profile_name}), but where a user other than root changes to
  # a profile, as systemd does for User=aries, Ubuntu 26.04 stacks the
  # profile on unconfined (kernel.apparmor_restrict_unprivileged_unconfined
  # is 1), and the daemon's label is ariesd-serve//&unconfined, which
  # that rule does not match.
  signal peer=@{profile_name}//&unconfined,

  owner @{PROC}/@{pid}/cgroup r,
  owner @{PROC}/@{pid}/mountinfo r,
  @{sys}/fs/cgroup/** r,

  audit deny @{ariesd_bin}/** w,
  audit deny @{ariesd_config} w,
  audit deny @{ariesd_authorized_keys} w,
  audit deny @{HOMEDIRS}/** mrwklx,
  audit deny /root/** mrwklx,
  audit deny /** x,
  # Every capability but net_bind_service, above: a deny would win over
  # that allow, so the others are named. A capability no rule allows is
  # refused all the same; these are the ones worth an audit line.
  audit deny capability chown dac_override dac_read_search fowner fsetid kill setgid setuid setpcap,
  audit deny capability net_admin net_raw sys_admin sys_module sys_ptrace sys_rawio sys_chroot,
  audit deny ptrace (trace),
  audit deny mount,
  audit deny umount,
  audit deny pivot_root,
  audit deny network netlink,
  audit deny network packet,
  audit deny network raw,

  include if exists <local/ariesd-serve>
}

# The operator's commands, entered with aa-exec as the aries user:
# control init, import-bd, export-bd, and upgrade with --check, --to and
# --rollback. Its rules are abstractions/ariesd-admin's, which
# ariesd-default shares: with SSH off that profile carries the binary's
# path, and a command run without aa-exec gets the same rules.
profile ariesd-admin flags=(attach_disconnected) {
  include <abstractions/ariesd-admin>
}
