# Where a starfix server keeps its files, for the AppArmor profiles of
# starfixd (/etc/apparmor.d/starfixd). Install this file as
# /etc/apparmor.d/tunables/starfixd.
#
# The values are those of docs/server.md. If you moved something, change
# it here and nowhere else, then reload the profiles:
#
#   apparmor_parser -r /etc/apparmor.d/starfixd
#
# AppArmor matches the path a file really has, with symbolic links
# resolved, so name the real directory, not a link to it.

# The directory that holds the starfixd binary. `starfixd upgrade`
# replaces the binary here and keeps the one it replaced beside it.
# /usr/local/bin/starfixd is a symbolic link to it and needs no entry.
@{starfixd_bin}=/opt/starfix/bin

# Every directory above it but the root, separated by spaces. `starfixd
# upgrade` looks at each to find the file it must replace.
@{starfixd_bin_above}=/opt /opt/starfix

# The config file (`--config`, STARFIXD_CONFIG).
@{starfixd_config}=/etc/starfix/starfixd.yaml

# The directory of the daemon's unix socket (`socket`; the unit's
# RuntimeDirectory).
@{starfixd_run}=/run/starfix

# The home directory of the account starfixd runs as. Not under /home:
# the profiles refuse everything there.
@{starfixd_home}=/var/lib/starfix

# The file starfixd writes for sshd on a server of many projects
# (`keys_file`), as its directory and its name, and the hand-maintained
# file it reads beside it (`authorized_keys`).
@{starfixd_keys_dir}=@{starfixd_home}/.ssh
@{starfixd_keys_name}=starfix_keys
@{starfixd_authorized_keys}=@{starfixd_home}/.ssh/authorized_keys
