{
  "title": "Aries spend (Sextant)",
  "uid": "aries-sextant",
  "tags": [
    "aries"
  ],
  "schemaVersion": 39,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "links": [
    {
      "title": "Aries dashboards",
      "type": "dashboards",
      "tags": [
        "aries"
      ],
      "asDropdown": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Spend by account, list price, over the window",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "sum by (account) (sextant_account_cost_usd{job=\"sextant\"})",
          "legendFormat": "{{account}}"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "currencyUSD"}, "overrides": []}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Spend by model, list price, over the window",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "sum by (model) (sextant_cost_usd{job=\"sextant\"})",
          "legendFormat": "{{model}}"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "currencyUSD"}, "overrides": []}
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Tokens by model and kind, over the window",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "sum by (model, kind) (sextant_tokens{job=\"sextant\"})",
          "legendFormat": "{{model}} {{kind}}"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Hours logged by account, over the window",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "sum by (account) (sextant_hours{job=\"sextant\"})",
          "legendFormat": "{{account}}"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "h"}, "overrides": []}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Unpriced tokens by model",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "sum by (model) (sextant_cost_unpriced_tokens{job=\"sextant\"})",
          "legendFormat": "{{model}}"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Sextant's failures to read a project",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "sum by (op, code) (increase(sextant_scrape_errors_total{job=\"sextant\"}[15m]))",
          "legendFormat": "{{op}} {{code}}"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}
    }
  ]
}
