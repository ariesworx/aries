{
  "title": "Aries server",
  "uid": "aries-server",
  "description": "One Aries server: ariesd. An example that is tested, not a product (docs/server.md, Observability). It expects the scrape job ariesd.",
  "schemaVersion": 39,
  "editable": true,
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus"
      }
    ]
  },
  "panels": [
    {
      "id": 101,
      "type": "stat",
      "title": "Connections",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(aries_connections)"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0"
        },
        "overrides": []
      }
    },
    {
      "id": 102,
      "type": "stat",
      "title": "Open project stores",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "aries_stores_open"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0"
        },
        "overrides": []
      }
    },
    {
      "id": 103,
      "type": "stat",
      "title": "Requests a second",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(aries_project_requests_total[5m]))"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "0",
          "decimals": 2
        },
        "overrides": []
      }
    },
    {
      "id": 104,
      "type": "stat",
      "title": "Refused or failed",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(aries_project_requests_total{result_class!=\"ok\"}[5m])) / sum(rate(aries_project_requests_total[5m]))"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "0",
          "decimals": 2
        },
        "overrides": []
      },
      "description": "The share of requests in the last 5 minutes that were refused or failed"
    },
    {
      "id": 105,
      "type": "stat",
      "title": "Request latency, 99th percentile",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(aries_request_duration_seconds_bucket[5m])))"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "0",
          "decimals": 2
        },
        "overrides": []
      }
    },
    {
      "id": 106,
      "type": "stat",
      "title": "Since the reaper last ran",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "time() - aries_reaper_last_run_time_seconds"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "0"
        },
        "overrides": []
      },
      "description": "The reaper ends lapsed claims; this should stay under a minute"
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests a second, by result",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result_class) (rate(aries_project_requests_total[5m]))",
          "legendFormat": "{{result_class}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Request latency",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(aries_request_duration_seconds_bucket[5m])))",
          "legendFormat": "median"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(aries_request_duration_seconds_bucket[5m])))",
          "legendFormat": "99th percentile"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Write latency, with the wait for the writer",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(aries_store_write_duration_seconds_bucket[5m])))",
          "legendFormat": "median write"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(aries_store_write_duration_seconds_bucket[5m])))",
          "legendFormat": "99th percentile write"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Writes a second, and those retried",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "wps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(aries_store_write_duration_seconds_count[5m]))",
          "legendFormat": "writes"
        },
        {
          "refId": "B",
          "expr": "sum(rate(aries_store_write_retries_total[5m]))",
          "legendFormat": "retries"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Connections and open stores",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(aries_connections)",
          "legendFormat": "connections"
        },
        {
          "refId": "B",
          "expr": "aries_stores_open",
          "legendFormat": "open stores"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Refusals at a limit, and connections the server closed",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (limit) (increase(aries_limit_refusals_total[5m]))",
          "legendFormat": "refused at {{limit}}"
        },
        {
          "refId": "B",
          "expr": "sum by (reason) (increase(aries_connections_dropped_total[5m]))",
          "legendFormat": "closed: {{reason}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Claims",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (event) (increase(aries_claims_total[5m]))",
          "legendFormat": "{{event}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "The server itself: reaper, clock and telemetry dropped",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - aries_reaper_last_run_time_seconds",
          "legendFormat": "seconds since the reaper ran"
        },
        {
          "refId": "B",
          "expr": "aries_clock_behind_seconds",
          "legendFormat": "seconds the clock is behind history"
        },
        {
          "refId": "C",
          "expr": "sum by (signal) (increase(aries_telemetry_dropped_total[5m]))",
          "legendFormat": "dropped: {{signal}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "ariesd's own memory and goroutines",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 36
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "go_memory_used_bytes{job=\"ariesd\"}",
          "legendFormat": "bytes in use"
        },
        {
          "refId": "B",
          "expr": "go_goroutine_count{job=\"ariesd\"}",
          "legendFormat": "goroutines"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Connections to Postgres: ariesd's pool, and waits for it",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 36
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "aries_db_pool_conns",
          "legendFormat": "held"
        },
        {
          "refId": "B",
          "expr": "aries_db_pool_in_use",
          "legendFormat": "in use"
        },
        {
          "refId": "C",
          "expr": "rate(aries_db_pool_waits_total[5m])",
          "legendFormat": "waits a second"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Gates: added, passed, failed, waived and rearmed",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 44
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind, event) (increase(aries_gates_total[5m]))",
          "legendFormat": "{{kind}} {{event}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "The HTTPS listener: connections, upgrades, key proofs and TLS",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 44
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "aries_https_connections",
          "legendFormat": "connections open"
        },
        {
          "refId": "B",
          "expr": "sum by (result, reason) (increase(aries_https_upgrades_total[5m]))",
          "legendFormat": "upgrade {{result}} {{reason}}"
        },
        {
          "refId": "C",
          "expr": "sum by (result) (increase(aries_https_key_proofs_total[5m]))",
          "legendFormat": "key proof {{result}}"
        },
        {
          "refId": "D",
          "expr": "increase(aries_https_tls_handshakes_failed_total[5m])",
          "legendFormat": "TLS handshakes failed"
        },
        {
          "refId": "E",
          "expr": "sum by (reason) (increase(aries_https_connections_refused_total[5m]))",
          "legendFormat": "refused {{reason}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Tokens a second, by model and kind",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 52
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (model, kind) (rate(aries_usage_tokens_total[5m]))",
          "legendFormat": "{{model}} {{kind}}"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Tokens in the last day, by model and kind",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 52
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (model, kind) (increase(aries_usage_tokens_total[1d]))",
          "legendFormat": "{{model}} {{kind}}"
        }
      ]
    }
  ],
  "links": [
    {
      "title": "Aries dashboards",
      "type": "dashboards",
      "tags": [
        "aries"
      ],
      "asDropdown": false
    }
  ],
  "tags": [
    "aries"
  ]
}
