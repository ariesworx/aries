{
  "title": "Aries work",
  "uid": "aries-work",
  "tags": [
    "aries"
  ],
  "schemaVersion": 39,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "1m",
  "links": [
    {
      "title": "Aries dashboards",
      "type": "dashboards",
      "tags": [
        "aries"
      ],
      "asDropdown": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Issues in progress, by project",
      "description": "Issues with a claim, counted at each scrape from each project whose store is open.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (project) (aries_issues{status=\"in_progress\"})",
          "legendFormat": "{{project}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Issues open and blocked, by project",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (project, status) (aries_issues{status=~\"open|blocked\"})",
          "legendFormat": "{{project}} {{status}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Issues closed a day",
      "description": "Closes of issues that had been started: an issue closed without a start is not counted.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (project) (increase(aries_issue_cycle_duration_seconds_count[1d]))",
          "legendFormat": "{{project}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Start to close, mean by type",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (type) (increase(aries_issue_cycle_duration_seconds_sum[$__range])) / sum by (type) (increase(aries_issue_cycle_duration_seconds_count[$__range]))",
          "legendFormat": "{{type}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Start to close, 50th and 90th percentile by type",
      "description": "Estimated from buckets that run from 1 minute to 14 days.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (type, le) (increase(aries_issue_cycle_duration_seconds_bucket[$__range])))",
          "legendFormat": "{{type}} p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.9, sum by (type, le) (increase(aries_issue_cycle_duration_seconds_bucket[$__range])))",
          "legendFormat": "{{type}} p90"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Tokens a second, by model and kind",
      "description": "A model reads (other) until the server has a price for it: set one with aries admin prices.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (model, kind) (rate(aries_usage_tokens_total[5m]))",
          "legendFormat": "{{model}} {{kind}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Tokens in the last day, by model and kind",
      "description": "A model reads (other) until the server has a price for it: set one with aries admin prices.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (model, kind) (increase(aries_usage_tokens_total[1d]))",
          "legendFormat": "{{model}} {{kind}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Queue time to first start, 50th and 90th percentile by type",
      "description": "From creation, or defer_until if later, to the first start. Time spent behind a blocker counts. Estimated from buckets that run from 1 minute to 14 days.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (type, le) (increase(aries_issue_queue_duration_seconds_bucket[$__range])))",
          "legendFormat": "{{type}} p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.9, sum by (type, le) (increase(aries_issue_queue_duration_seconds_bucket[$__range])))",
          "legendFormat": "{{type}} p90"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Awaiting landing, 50th and 90th percentile by type",
      "description": "From the last handoff with state done to the close by the closing pass: the wait for review and merge.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (type, le) (increase(aries_issue_landing_duration_seconds_bucket[$__range])))",
          "legendFormat": "{{type}} p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.9, sum by (type, le) (increase(aries_issue_landing_duration_seconds_bucket[$__range])))",
          "legendFormat": "{{type}} p90"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Gate wait, 50th and 90th percentile by kind",
      "description": "From a gate's add, or last rearm, to its pass or waiver. A kind is human or ci.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (kind, le) (increase(aries_gate_wait_duration_seconds_bucket[$__range])))",
          "legendFormat": "{{kind}} p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.9, sum by (kind, le) (increase(aries_gate_wait_duration_seconds_bucket[$__range])))",
          "legendFormat": "{{kind}} p90"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Issues closed a day, by reason",
      "description": "landed: the closing pass of the check landed. forced: a close that overrode open items or checks. other: every other close.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 48
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (increase(aries_issues_closed_total[1d]))",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Revert rate",
      "description": "Reopens by a failed check over closes that landed, a day at a time. Empty when nothing landed.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 56
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(aries_issues_reopened_total{reason=\"check_failed\"}[1d])) / sum(increase(aries_issues_closed_total{reason=\"landed\"}[1d]))",
          "legendFormat": "revert rate"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Reverts and landed closes a day",
      "description": "The counts behind the revert rate.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 56
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(aries_issues_reopened_total{reason=\"check_failed\"}[1d]))",
          "legendFormat": "reverts"
        },
        {
          "refId": "B",
          "expr": "sum(increase(aries_issues_closed_total{reason=\"landed\"}[1d]))",
          "legendFormat": "landed closes"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Reopen rate",
      "description": "Reopens of every reason over closes of every reason, a day at a time.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 64
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(aries_issues_reopened_total[1d])) / sum(increase(aries_issues_closed_total[1d]))",
          "legendFormat": "reopen rate"
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Reopens and closes a day",
      "description": "The counts behind the reopen rate.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 64
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(aries_issues_reopened_total[1d]))",
          "legendFormat": "reopens"
        },
        {
          "refId": "B",
          "expr": "sum(increase(aries_issues_closed_total[1d]))",
          "legendFormat": "closes"
        }
      ]
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Forced share of closes",
      "description": "Closes that overrode open items or checks over all closes, a day at a time.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 72
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(aries_issues_closed_total{reason=\"forced\"}[1d])) / sum(increase(aries_issues_closed_total[1d]))",
          "legendFormat": "forced share"
        }
      ]
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Forced closes and closes a day",
      "description": "The counts behind the forced share.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 72
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(aries_issues_closed_total{reason=\"forced\"}[1d]))",
          "legendFormat": "forced"
        },
        {
          "refId": "B",
          "expr": "sum(increase(aries_issues_closed_total[1d]))",
          "legendFormat": "closes"
        }
      ]
    }
  ]
}
